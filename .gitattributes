# LF everywhere (PHPCS refuses CRLF), whatever core.autocrlf says on Windows.
* text=auto eol=lf
*.mo binary
*.png binary
*.jpg binary
*.webp binary
*.woff2 binary

# Development files stay out of `git archive` (the release zip is built from it).
/bin                 export-ignore
/.editorconfig       export-ignore
/.gitattributes      export-ignore
/.github             export-ignore
/.gitignore          export-ignore
/.wordpress-org      export-ignore
/LICENSE             export-ignore
/README.md           export-ignore
/README.fa.md        export-ignore
/SECURITY.md         export-ignore
/docs                export-ignore
/graft               export-ignore
/phpcs.xml.dist      export-ignore
/phpstan.neon.dist   export-ignore
/phpunit.xml.dist    export-ignore
/site                export-ignore
/tests               export-ignore
# Translations come from translate.wordpress.org; the Persian source stays here for importing there.
/languages/*.po      export-ignore
/languages/*.mo      export-ignore
/languages/*.l10n.php export-ignore
