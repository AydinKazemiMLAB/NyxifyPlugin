#. Plugin Name of the plugin
#: nyxify.php:3
msgid "Nyxify – Shop Bots for WooCommerce"
msgstr "Nyxify – ربات‌های فروشگاه برای ووکامرس"

#. Description of the plugin
#: nyxify.php:4
msgid "Sell your WooCommerce products through Telegram, Bale and Rubika bots."
msgstr "محصولات فروشگاه ووکامرس خود را با ربات‌های تلگرام، بله و روبیکا بفروشید."

#. Author of the plugin
#: nyxify.php:9
msgid "Nyxon"
msgstr "Nyxon"

#: nyxify.php:48
msgid "Nyxify is incomplete: its vendor folder is missing. Reinstall the plugin from its release zip."
msgstr "Nyxify ناقص است: پوشهٔ vendor آن وجود ندارد. افزونه را دوباره از فایل zip انتشار نصب کنید."

