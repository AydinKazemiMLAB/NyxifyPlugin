msgstr "شناسه‌ی درخواست (برای پشتیبانی WooNyx):"

#: src/Features/Settings/SettingsPage.php:303
msgid "The store is connected to WooNyx."
msgstr "فروشگاه به WooNyx متصل شد."

#: src/Features/Settings/SettingsPage.php:304
msgid "The shared secret was replaced with a new one. The store stays connected."
msgstr "کلید مشترک با یک کلید تازه عوض شد. فروشگاه متصل می‌ماند."

#: src/Features/Settings/SettingsPage.php:319
msgid "Connected"
msgstr "متصل"

#: src/Features/Settings/SettingsPage.php:320
msgid "Store ID:"
msgstr "شناسهٔ فروشگاه:"

#: src/Features/Settings/SettingsPage.php:331
msgid "Connection lost"
msgstr "اتصال از دست رفته"

#: src/Features/Settings/SettingsPage.php:331
msgid "Not connected"
msgstr "متصل نیست"

