#. Plugin Name of the plugin
#: woonyx.php:3
#: src/Features/Settings/SettingsPage.php:83
#: src/Features/Settings/SettingsPage.php:84
#: src/Features/Settings/SettingsPage.php:139
msgid "WooNyx"
msgstr "WooNyx"

#. Description of the plugin
#: woonyx.php:4
msgid "Sell your WooCommerce products through Telegram, Bale and Rubika bots."
msgstr "محصولات فروشگاه ووکامرس خود را با ربات‌های تلگرام، بله و روبیکا بفروشید."

#. Author of the plugin
#: woonyx.php:9
msgid "Nyxon"
msgstr "Nyxon"

#: src/Features/Settings/SettingsPage.php:111
msgid "Settings"
msgstr "تنظیمات"

#: src/Features/Settings/SettingsPage.php:134
msgid "Sorry, you are not allowed to access this page."
msgstr "متأسفانه اجازهٔ دسترسی به این صفحه را ندارید."

#: src/Features/Settings/SettingsPage.php:141
msgid "Connection"
msgstr "اتصال"

#: src/Features/Settings/SettingsPage.php:145
msgid "Status"
msgstr "وضعیت"

#: src/Features/Settings/SettingsPage.php:149
msgid "WooNyx server"
msgstr "سرور WooNyx"

#: src/Features/Settings/SettingsPage.php:153
msgid "Set by WOONYX_API_BASE_URL in wp-config.php."
msgstr "با WOONYX_API_BASE_URL در wp-config.php تعیین شده است."

#: src/Features/Settings/SettingsPage.php:160
msgid "Nothing is sent to the WooNyx server until you enter a license key."
msgstr "تا وقتی کلید لایسنس را وارد نکنید، هیچ داده‌ای به سرور WooNyx فرستاده نمی‌شود."

#: src/Features/Settings/SettingsPage.php:174
msgid "Connected"
msgstr "متصل"

#: src/Features/Settings/SettingsPage.php:175
msgid "Store ID:"
msgstr "شناسهٔ فروشگاه:"

#: src/Features/Settings/SettingsPage.php:186
msgid "Connection lost"
msgstr "اتصال از دست رفته"

#: src/Features/Settings/SettingsPage.php:186
msgid "Not connected"
msgstr "متصل نیست"

#. translators: %s: the oldest supported WooCommerce version, e.g. 9.0
#: src/Plugin.php:103
#, php-format
msgid "WooNyx needs WooCommerce %s or later. Install, activate or update WooCommerce to use it."
msgstr "WooNyx به ووکامرس %s یا جدیدتر نیاز دارد. برای استفاده از آن، ووکامرس را نصب، فعال یا به‌روزرسانی کنید."

#: src/Shared/Admin/AdminAction.php:77
msgid "Sorry, you are not allowed to do that."
msgstr "متأسفانه اجازهٔ انجام این کار را ندارید."

#: src/Shared/Http/ErrorMessages.php:102
msgid "This store is not connected to WooNyx yet. Enter your license key to activate it."
msgstr "این فروشگاه هنوز به WooNyx وصل نشده است. برای فعال‌سازی، کلید لایسنس خود را وارد کنید."

#: src/Shared/Http/ErrorMessages.php:103
msgid "The saved connection to WooNyx can no longer be read, probably because the site’s security keys (salts) changed. Enter your license key again to reconnect."
msgstr "اتصال ذخیره‌شده به WooNyx دیگر خوانده نمی‌شود؛ احتمالاً کلیدهای امنیتی سایت (salt) تغییر کرده‌اند. برای اتصال دوباره، کلید لایسنس را دوباره وارد کنید."

#: src/Shared/Http/ErrorMessages.php:104
msgid "The WooNyx server address is invalid. Check WOONYX_API_BASE_URL in wp-config.php: it must be an https address."
msgstr "نشانی سرور WooNyx نامعتبر است. مقدار WOONYX_API_BASE_URL را در wp-config.php بررسی کنید؛ باید یک نشانی https باشد."

#: src/Shared/Http/ErrorMessages.php:105
msgid "The data could not be prepared for sending to WooNyx."
msgstr "داده‌ها برای ارسال به WooNyx آماده نشدند."

#: src/Shared/Http/ErrorMessages.php:106
msgid "Could not reach the WooNyx server. Check this site’s internet connection and try again in a few minutes."
msgstr "دسترسی به سرور WooNyx ممکن نشد. اتصال اینترنت این سایت را بررسی کنید و چند دقیقهٔ دیگر دوباره تلاش کنید."

#: src/Shared/Http/ErrorMessages.php:107
msgid "The WooNyx server answered with a redirect, which is not followed. Check the server address."
msgstr "سرور WooNyx با تغییر مسیر (redirect) پاسخ داد که دنبال نمی‌شود. نشانی سرور را بررسی کنید."

#: src/Shared/Http/ErrorMessages.php:108
msgid "The WooNyx server sent an unexpected answer. Try again later."
msgstr "سرور WooNyx پاسخ غیرمنتظره‌ای فرستاد. بعداً دوباره تلاش کنید."

#: src/Shared/Http/ErrorMessages.php:109
msgid "Something went wrong while talking to the WooNyx server. Try again later."
msgstr "در ارتباط با سرور WooNyx مشکلی پیش آمد. بعداً دوباره تلاش کنید."

#: src/Shared/Http/ErrorMessages.php:112
msgid "The WooNyx server rejected the request as invalid. Update the plugin and try again."
msgstr "سرور WooNyx درخواست را نامعتبر دانست و رد کرد. افزونه را به‌روز کنید و دوباره تلاش کنید."

#: src/Shared/Http/ErrorMessages.php:113
msgid "The WooNyx server did not accept this store’s credentials. Activate the store again with your license key."
msgstr "سرور WooNyx اعتبارنامهٔ این فروشگاه را نپذیرفت. فروشگاه را با کلید لایسنس دوباره فعال کنید."

#: src/Shared/Http/ErrorMessages.php:114
msgid "The WooNyx server does not accept this request. Update the plugin."
msgstr "سرور WooNyx این درخواست را نمی‌پذیرد. افزونه را به‌روز کنید."

#: src/Shared/Http/ErrorMessages.php:115
msgid "Some of the data sent to WooNyx is invalid. Check it and try again."
msgstr "بخشی از داده‌های ارسال‌شده به WooNyx نامعتبر است. آن را بررسی کنید و دوباره تلاش کنید."

#: src/Shared/Http/ErrorMessages.php:116
msgid "The data is too large for the WooNyx server."
msgstr "حجم داده‌ها برای سرور WooNyx بیش از حد است."

#: src/Shared/Http/ErrorMessages.php:117
msgid "The WooNyx server had an internal error. Try again later."
msgstr "سرور WooNyx با خطای داخلی روبه‌رو شد. بعداً دوباره تلاش کنید."

#: src/Shared/Http/ErrorMessages.php:118
msgid "The WooNyx server could not read this store’s saved credentials. Activate the store again with your license key."
msgstr "سرور WooNyx نتوانست اعتبارنامهٔ ذخیره‌شدهٔ این فروشگاه را بخواند. فروشگاه را با کلید لایسنس دوباره فعال کنید."

#: src/Shared/Http/ErrorMessages.php:119
msgid "Too many attempts. Wait a few minutes and try again."
msgstr "تعداد تلاش‌ها بیش از حد است. چند دقیقه صبر کنید و دوباره تلاش کنید."

#: src/Shared/Http/ErrorMessages.php:122
msgid "The request’s signature was missing or malformed. Activate the store again with your license key."
msgstr "امضای درخواست وجود نداشت یا نادرست بود. فروشگاه را با کلید لایسنس دوباره فعال کنید."

#: src/Shared/Http/ErrorMessages.php:123
msgid "The request was rejected because this server’s clock is off by more than five minutes. Correct the server time and try again."
msgstr "درخواست رد شد، چون ساعت این سرور بیش از پنج دقیقه اختلاف دارد. ساعت سرور را درست کنید و دوباره تلاش کنید."

#: src/Shared/Http/ErrorMessages.php:124
msgid "The request’s signature did not match; the shared secret may be out of date. Activate the store again with your license key."
msgstr "امضای درخواست مطابقت نداشت؛ ممکن است کلید مشترک قدیمی شده باشد. فروشگاه را با کلید لایسنس دوباره فعال کنید."

#: src/Shared/Http/ErrorMessages.php:125
msgid "The same request reached the WooNyx server twice and was rejected. Try again."
msgstr "همین درخواست دو بار به سرور WooNyx رسید و رد شد. دوباره تلاش کنید."

#: src/Shared/Http/ErrorMessages.php:128
msgid "This license key is not valid. Check it and try again."
msgstr "این کلید لایسنس معتبر نیست. آن را بررسی کنید و دوباره تلاش کنید."

#: src/Shared/Http/ErrorMessages.php:129
msgid "This license key has been revoked. Contact WooNyx support."
msgstr "این کلید لایسنس باطل شده است. با پشتیبانی WooNyx تماس بگیرید."

#: src/Shared/Http/ErrorMessages.php:130
msgid "This license key is already used by another website."
msgstr "این کلید لایسنس پیش‌تر برای وب‌سایت دیگری به کار رفته است."

#: src/Shared/Http/ErrorMessages.php:131
msgid "This website is already activated with another license key."
msgstr "این وب‌سایت پیش‌تر با کلید لایسنس دیگری فعال شده است."

#: src/Shared/Http/ErrorMessages.php:132
msgid "This store is deactivated or suspended on WooNyx. Activate it again with your license key; if the license was revoked, contact WooNyx support."
msgstr "این فروشگاه در WooNyx غیرفعال یا معلق است. آن را با کلید لایسنس دوباره فعال کنید؛ اگر لایسنس باطل شده، با پشتیبانی WooNyx تماس بگیرید."

#: src/Shared/Http/ErrorMessages.php:133
msgid "Your WooNyx subscription is not active or has expired. Renew it to continue."
msgstr "اشتراک WooNyx شما فعال نیست یا منقضی شده است. برای ادامه، آن را تمدید کنید."

#: src/Shared/Http/ErrorMessages.php:134
msgid "Your WooNyx plan does not include this messenger. Upgrade your plan to use it."
msgstr "طرح WooNyx شما این پیام‌رسان را شامل نمی‌شود. برای استفاده از آن، طرح خود را ارتقا دهید."

#: src/Shared/Http/ErrorMessages.php:135
msgid "The WooNyx server could not sign in to this store’s WooCommerce REST API with the new key. Make sure no security plugin blocks the REST API, then try again."
msgstr "سرور WooNyx نتوانست با کلید تازه به REST API ووکامرس این فروشگاه وارد شود. مطمئن شوید هیچ افزونهٔ امنیتی جلوی REST API را نگرفته است، سپس دوباره تلاش کنید."

#: src/Shared/Http/ErrorMessages.php:136
msgid "The WooNyx server could not reach this store. The site must be public, use https, and its REST API must not redirect."
msgstr "سرور WooNyx به این فروشگاه دسترسی پیدا نکرد. سایت باید عمومی باشد، از https استفاده کند و REST API آن نباید تغییر مسیر (redirect) بدهد."

#: src/Shared/Http/ErrorMessages.php:137
msgid "This store’s WooCommerce REST API rejected the WooNyx server’s request. Check the firewall and security plugins."
msgstr "REST API ووکامرس این فروشگاه درخواست سرور WooNyx را رد کرد. فایروال و افزونه‌های امنیتی را بررسی کنید."

#: src/Shared/Http/ErrorMessages.php:138
msgid "This store’s WooCommerce REST API sent the WooNyx server an unexpected answer. Check for plugins that change REST API responses."
msgstr "REST API ووکامرس این فروشگاه پاسخ غیرمنتظره‌ای به سرور WooNyx داد. افزونه‌هایی را که پاسخ‌های REST API را تغییر می‌دهند بررسی کنید."

#: src/Shared/Http/ErrorMessages.php:141
msgid "A bot is already connected for this messenger. Remove it first to connect another one."
msgstr "برای این پیام‌رسان از قبل یک ربات وصل است. برای وصل کردن ربات دیگر، اول آن را حذف کنید."

#: src/Shared/Http/ErrorMessages.php:142
msgid "No bot is connected for this messenger."
msgstr "هیچ رباتی برای این پیام‌رسان وصل نیست."

#: src/Shared/Http/ErrorMessages.php:143
msgid "This bot admin no longer exists."
msgstr "این مدیر ربات دیگر وجود ندارد."

#: src/Shared/Http/ErrorMessages.php:144
msgid "The messenger rejected this bot token. Check it and try again."
msgstr "پیام‌رسان این توکن ربات را نپذیرفت. آن را بررسی کنید و دوباره تلاش کنید."

#: src/Shared/Http/ErrorMessages.php:145
msgid "The messenger’s servers did not respond. Try again in a few minutes."
msgstr "سرورهای پیام‌رسان پاسخ ندادند. چند دقیقهٔ دیگر دوباره تلاش کنید."

#: woonyx.php:49
msgid "WooNyx is incomplete: its vendor folder is missing. Reinstall the plugin from its release zip."
msgstr "WooNyx ناقص است: پوشهٔ vendor آن وجود ندارد. افزونه را دوباره از فایل zip انتشار نصب کنید."
