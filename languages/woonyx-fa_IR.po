#. Plugin Name of the plugin
#: woonyx.php:3
#: src/Features/Settings/SettingsPage.php:143
#: src/Features/Settings/SettingsPage.php:144
#: src/Features/Settings/SettingsPage.php:211
msgid "WooNyx"
msgstr "WooNyx"

#. Description of the plugin
#: woonyx.php:4
msgid "Sell your WooCommerce products through Telegram, Bale and Rubika bots."
msgstr "محصولات فروشگاه ووکامرس خود را با ربات‌های تلگرام، بله و روبیکا بفروشید."

#. Author of the plugin
#: woonyx.php:9
msgid "Nyxon"
msgstr "Nyxon"

#: src/Features/Bots/BotPlatform.php:78
#: src/Features/Settings/StatusSection.php:186
msgid "Telegram"
msgstr "تلگرام"

#: src/Features/Bots/BotPlatform.php:79
#: src/Features/Settings/StatusSection.php:187
msgid "Bale"
msgstr "بله"

#: src/Features/Bots/BotPlatform.php:80
#: src/Features/Settings/StatusSection.php:188
msgid "Rubika"
msgstr "روبیکا"

#: src/Features/Settings/AdminPinSection.php:50
msgid "Admin PIN"
msgstr "PIN ادمین"

#: src/Features/Settings/AdminPinSection.php:51
msgid "Anyone who sends this PIN to one of your bots becomes a bot admin and can manage your shop from the bot. Share it only with people you trust."
msgstr "هر کس این PIN را به یکی از ربات‌های شما بفرستد، ادمین ربات می‌شود و می‌تواند فروشگاه شما را از داخل ربات مدیریت کند. آن را فقط به افراد مورد اعتماد بدهید."

#: src/Features/Settings/AdminPinSection.php:53
msgid "No PIN has been issued from this site yet."
msgstr "هنوز از این سایت PINی صادر نشده است."

#: src/Features/Settings/AdminPinSection.php:56
msgid "Show PIN"
msgstr "نمایش PIN"

#: src/Features/Settings/AdminPinSection.php:58
msgid "The last PIN issued from this site. Issuing a new one makes it stop working."
msgstr "آخرین PINی که از این سایت صادر شده است. صدور PIN جدید آن را از کار می‌اندازد."

#: src/Features/Settings/AdminPinSection.php:63
msgid "A new PIN can be issued here once the store is active and its status above can be read."
msgstr "وقتی فروشگاه فعال باشد و وضعیت آن در بالا خوانده شود، از اینجا می‌توانید PIN جدید صادر کنید."

#: src/Features/Settings/AdminPinSection.php:79
msgid "Issue a new PIN and log out every bot admin? Everyone will need the new PIN to become an admin again."
msgstr "PIN جدید صادر شود و همهٔ ادمین‌های ربات خارج شوند؟ همه برای ادمین شدن دوباره به PIN جدید نیاز خواهند داشت."

#: src/Features/Settings/AdminPinSection.php:80
msgid "Issue a new PIN? The current PIN stops working; current bot admins stay admins."
msgstr "PIN جدید صادر شود؟ PIN فعلی از کار می‌افتد؛ ادمین‌های فعلی ربات ادمین می‌مانند."

#: src/Features/Settings/AdminPinSection.php:88
msgid "New PIN and log out every admin"
msgstr "PIN جدید و خروج همهٔ ادمین‌ها"

#: src/Features/Settings/AdminPinSection.php:88
msgid "New PIN"
msgstr "PIN جدید"

#: src/Features/Settings/AdminsSection.php:53
msgid "Bot admins"
msgstr "ادمین‌های ربات"

#: src/Features/Settings/AdminsSection.php:56
msgid "The bot admins can be managed here once the store’s status above can be read."
msgstr "وقتی وضعیت فروشگاه در بالا خوانده شود، ادمین‌های ربات را از اینجا می‌توانید مدیریت کنید."

#: src/Features/Settings/AdminsSection.php:61
msgid "The bot admins can be managed here once the store is active on WooNyx again."
msgstr "وقتی فروشگاه دوباره در WooNyx فعال شود، ادمین‌های ربات را از اینجا می‌توانید مدیریت کنید."

#: src/Features/Settings/AdminsSection.php:71
msgid "People who sent the admin PIN to one of your bots. Removing one takes away their admin access, but the current PIN still works for them: issue a new PIN too if they shouldn’t come back."
msgstr "کسانی که PIN ادمین را به یکی از ربات‌های شما فرستاده‌اند. حذف هر کدام دسترسی ادمینی او را می‌گیرد، اما PIN فعلی هنوز برای او کار می‌کند: اگر نباید دوباره ادمین شود، PIN جدید هم صادر کنید."

#: src/Features/Settings/AdminsSection.php:74
msgid "No one is a bot admin yet."
msgstr "هنوز کسی ادمین ربات نشده است."

#: src/Features/Settings/AdminsSection.php:82
msgid "Messenger"
msgstr "پیام‌رسان"

#: src/Features/Settings/AdminsSection.php:83
msgid "Name"
msgstr "نام"

#: src/Features/Settings/AdminsSection.php:84
msgid "Username"
msgstr "نام کاربری"

#: src/Features/Settings/AdminsSection.php:85
msgid "Actions"
msgstr "عملیات"

#. translators: %s: the bot admin's name, username or messenger user id
#: src/Features/Settings/AdminsSection.php:107
#, php-format
msgid "Remove %s as a bot admin? The current PIN still works for them until you issue a new one."
msgstr "%s از ادمین‌های ربات حذف شود؟ تا وقتی PIN جدید صادر نکنید، PIN فعلی هنوز برای او کار می‌کند."

#: src/Features/Settings/AdminsSection.php:117
msgid "Messenger ID:"
msgstr "شناسه در پیام‌رسان:"

#: src/Features/Settings/AdminsSection.php:136
msgid "Remove"
msgstr "حذف"

#: src/Features/Settings/BotsSection.php:56
msgid "Bots"
msgstr "ربات‌ها"

#: src/Features/Settings/BotsSection.php:59
msgid "The bots can be managed here once the store’s status above can be read."
msgstr "وقتی وضعیت فروشگاه در بالا خوانده شود، ربات‌ها را می‌توانید از اینجا مدیریت کنید."

#: src/Features/Settings/BotsSection.php:64
msgid "The bots can be managed here once the store is active on WooNyx again."
msgstr "وقتی فروشگاه دوباره در WooNyx فعال شود، ربات‌ها را می‌توانید از اینجا مدیریت کنید."

#: src/Features/Settings/BotsSection.php:81
msgid "Your plan doesn’t include any messenger. Upgrade your plan to connect a bot."
msgstr "پلن شما هیچ پیام‌رسانی ندارد. برای وصل کردن ربات، پلن خود را ارتقا دهید."

#: src/Features/Settings/BotsSection.php:85
msgid "One bot per messenger. A bot token is sent once to WooNyx and is not stored on this site."
msgstr "برای هر پیام‌رسان یک ربات. توکن ربات یک بار به WooNyx فرستاده می‌شود و در این سایت ذخیره نمی‌شود."

#: src/Features/Settings/BotsSection.php:125
msgid "No bot is connected."
msgstr "رباتی وصل نیست."

#: src/Features/Settings/BotsSection.php:134
msgid "This messenger isn’t in your plan, so the bot doesn’t work. Remove it, or upgrade your plan."
msgstr "این پیام‌رسان در پلن شما نیست، پس ربات کار نمی‌کند. آن را حذف کنید یا پلن خود را ارتقا دهید."

#: src/Features/Settings/BotsSection.php:143
msgid "Replace with another bot"
msgstr "جایگزینی با ربات دیگر"

#: src/Features/Settings/BotsSection.php:162
msgid "Bot"
msgstr "ربات"

#: src/Features/Settings/BotsSection.php:168
#: src/Features/Settings/SettingsPage.php:219
msgid "Status"
msgstr "وضعیت"

#: src/Features/Settings/BotsSection.php:173
msgid "WooNyx is setting the bot up; this usually takes a few seconds."
msgstr "WooNyx در حال راه‌اندازی ربات است؛ معمولاً چند ثانیه طول می‌کشد."

#: src/Features/Settings/BotsSection.php:174
msgid "Check again"
msgstr "بررسی دوباره"

#: src/Features/Settings/BotsSection.php:179
msgid "Setting up the bot failed. WooNyx tries again every hour, up to five times; you can also enter its token again."
msgstr "راه‌اندازی ربات ناموفق بود. WooNyx هر ساعت، تا پنج بار، دوباره تلاش می‌کند؛ می‌توانید توکن آن را هم دوباره وارد کنید."

#: src/Features/Settings/BotsSection.php:181
msgid "Details:"
msgstr "جزئیات:"

#: src/Features/Settings/BotsSection.php:188
msgid "Webhook"
msgstr "وب‌هوک"

#: src/Features/Settings/BotsSection.php:189
msgid "Set"
msgstr "تنظیم شده"

#: src/Features/Settings/BotsSection.php:189
msgid "Not set"
msgstr "تنظیم نشده"

#: src/Features/Settings/BotsSection.php:193
msgid "Set up"
msgstr "راه‌اندازی"

#. translators: %s: messenger name, e.g. Telegram
#: src/Features/Settings/BotsSection.php:241
#, php-format
msgid "Replace the %s bot with the bot of this token? The current bot stops answering your customers."
msgstr "ربات %s با ربات این توکن جایگزین شود؟ ربات فعلی دیگر به مشتریان شما پاسخ نمی‌دهد."

#: src/Features/Settings/BotsSection.php:249
msgid "Bot token"
msgstr "توکن ربات"

#: src/Features/Settings/BotsSection.php:252
msgid "The token the messenger gave you when you created the bot (for example with BotFather). It is sent once to WooNyx and is not stored on this site."
msgstr "توکنی که پیام‌رسان هنگام ساختن ربات به شما داد (مثلاً با BotFather). یک بار به WooNyx فرستاده می‌شود و در این سایت ذخیره نمی‌شود."

#: src/Features/Settings/BotsSection.php:254
msgid "Replace bot"
msgstr "جایگزینی ربات"

#: src/Features/Settings/BotsSection.php:254
msgid "Connect bot"
msgstr "وصل کردن ربات"

#. translators: %s: messenger name, e.g. Telegram
#: src/Features/Settings/BotsSection.php:267
#, php-format
msgid "Remove the %s bot? It stops answering your customers."
msgstr "ربات %s حذف شود؟ دیگر به مشتریان شما پاسخ نمی‌دهد."

#: src/Features/Settings/BotsSection.php:273
msgid "Remove bot"
msgstr "حذف ربات"

#: src/Features/Settings/BotsSection.php:285
msgid "Setting up…"
msgstr "در حال راه‌اندازی…"

#: src/Features/Settings/BotsSection.php:286
#: src/Features/Settings/StatusSection.php:145
msgid "Active"
msgstr "فعال"

#: src/Features/Settings/BotsSection.php:287
#: src/Features/Settings/StatusSection.php:161
msgid "Failed"
msgstr "ناموفق"

#: src/Features/Settings/DeactivationWarning.php:62
msgid "Deactivating WooNyx stops your shop’s bots. To connect again you will need your license key."
msgstr "غیرفعال کردن WooNyx ربات‌های فروشگاه شما را متوقف می‌کند. برای اتصال دوباره به کلید لایسنس خود نیاز خواهید داشت."

#: src/Features/Settings/DeactivationWarning.php:69
msgid "When the plugin is deactivated, WooNyx is told and this site’s connection and WooCommerce REST API key are removed. If the WooNyx server can’t be reached, or your subscription has expired, WooNyx keeps the store connected and both stay on this site until you delete the plugin."
msgstr "وقتی افزونه غیرفعال شود، به WooNyx خبر داده می‌شود و اتصال این سایت و کلید REST API ووکامرس آن حذف می‌شوند. اگر سرور WooNyx در دسترس نباشد یا اشتراک شما منقضی شده باشد، WooNyx فروشگاه را متصل نگه می‌دارد و هر دو تا زمانی که افزونه را حذف کنید روی این سایت می‌مانند."

#: src/Features/Settings/ErrorNotice.php:35
#: src/Features/Settings/SettingsPage.php:334
msgid "Request ID (for WooNyx support):"
msgstr "شناسه‌ی درخواست (برای پشتیبانی WooNyx):"

#: src/Features/Settings/SettingsPage.php:171
msgid "Settings"
msgstr "تنظیمات"

#: src/Features/Settings/SettingsPage.php:204
msgid "Sorry, you are not allowed to access this page."
msgstr "متأسفانه اجازهٔ دسترسی به این صفحه را ندارید."

#: src/Features/Settings/SettingsPage.php:215
msgid "Connection"
msgstr "اتصال"

#: src/Features/Settings/SettingsPage.php:223
msgid "WooNyx server"
msgstr "سرور WooNyx"

#: src/Features/Settings/SettingsPage.php:227
msgid "Set by WOONYX_API_BASE_URL in wp-config.php."
msgstr "با WOONYX_API_BASE_URL در wp-config.php تعیین شده است."

#: src/Features/Settings/SettingsPage.php:242
#: src/Features/Settings/SettingsPage.php:299
msgid "Activate again"
msgstr "فعال‌سازی دوباره"

#: src/Features/Settings/SettingsPage.php:243
msgid "Use this if the connection stops working. This site keeps its store ID and gets a new shared secret."
msgstr "اگر اتصال از کار افتاد از این استفاده کنید. شناسه‌ی فروشگاه این سایت همان می‌ماند و یک کلید مشترک تازه می‌گیرد."

#: src/Features/Settings/SettingsPage.php:251
#: src/Features/Settings/SettingsPage.php:299
msgid "Activate"
msgstr "فعال‌سازی"

#: src/Features/Settings/SettingsPage.php:253
msgid "Nothing is sent to the WooNyx server until you enter a license key."
msgstr "تا وقتی کلید لایسنس را وارد نکنید، هیچ داده‌ای به سرور WooNyx فرستاده نمی‌شود."

#: src/Features/Settings/SettingsPage.php:264
msgid "Shared secret"
msgstr "کلید مشترک"

#: src/Features/Settings/SettingsPage.php:265
msgid "This site signs every request to WooNyx with a shared secret, kept encrypted here and never shown. Rotate it if you think it may have leaked; the store stays connected."
msgstr "این سایت هر درخواست به WooNyx را با یک کلید مشترک امضا می‌کند که رمزنگاری‌شده همین‌جا نگه داشته می‌شود و هیچ‌وقت نمایش داده نمی‌شود. اگر فکر می‌کنید ممکن است لو رفته باشد، آن را عوض کنید؛ فروشگاه متصل می‌ماند."

#: src/Features/Settings/SettingsPage.php:266
msgid "Replace the shared secret with a new one now? The store stays connected."
msgstr "کلید مشترک همین حالا با یک کلید تازه عوض شود؟ فروشگاه متصل می‌ماند."

#: src/Features/Settings/SettingsPage.php:269
msgid "Rotate secret"
msgstr "تعویض کلید مشترک"

#: src/Features/Settings/SettingsPage.php:287
msgid "License key"
msgstr "کلید لایسنس"

#: src/Features/Settings/SettingsPage.php:291
msgid "The key is sent once to the WooNyx server and is not stored on this site."
msgstr "کلید فقط یک بار به سرور WooNyx فرستاده می‌شود و در این سایت ذخیره نمی‌شود."

#: src/Features/Settings/SettingsPage.php:292
msgid "Activating creates a WooCommerce REST API key (read/write) for your user account; WooNyx uses it to read your catalog and create orders. If this user or the key is deleted, the store is disconnected."
msgstr "فعال‌سازی برای حساب کاربری شما یک کلید REST API ووکامرس (خواندن/نوشتن) می‌سازد؛ WooNyx با آن کاتالوگ شما را می‌خواند و سفارش ثبت می‌کند. اگر این کاربر یا این کلید حذف شود، اتصال فروشگاه قطع می‌شود."

#: src/Features/Settings/SettingsPage.php:327
msgid "Invalid fields:"
msgstr "فیلدهای نامعتبر:"

#: src/Features/Settings/SettingsPage.php:348
msgid "The store is connected to WooNyx."
msgstr "فروشگاه به WooNyx متصل شد."

#: src/Features/Settings/SettingsPage.php:349
msgid "The shared secret was replaced with a new one. The store stays connected."
msgstr "کلید مشترک با یک کلید تازه عوض شد. فروشگاه متصل می‌ماند."

#: src/Features/Settings/SettingsPage.php:350
msgid "The bot token was accepted. WooNyx is setting the bot up; check its status below."
msgstr "توکن ربات پذیرفته شد. WooNyx در حال راه‌اندازی ربات است؛ وضعیت آن را در پایین ببینید."

#: src/Features/Settings/SettingsPage.php:351
msgid "The bot was removed. It no longer answers your customers."
msgstr "ربات حذف شد. دیگر به مشتریان شما پاسخ نمی‌دهد."

#: src/Features/Settings/SettingsPage.php:352
msgid "A new admin PIN was issued; the previous one no longer works. Bot admins stay admins."
msgstr "PIN ادمین جدید صادر شد؛ PIN قبلی دیگر کار نمی‌کند. ادمین‌های ربات ادمین می‌مانند."

#: src/Features/Settings/SettingsPage.php:353
msgid "A new admin PIN was issued and every bot admin was logged out."
msgstr "PIN ادمین جدید صادر شد و همهٔ ادمین‌های ربات خارج شدند."

#: src/Features/Settings/SettingsPage.php:354
msgid "The bot admin was removed. The current PIN still works for them until you issue a new one."
msgstr "ادمین ربات حذف شد. تا وقتی PIN جدید صادر نکنید، PIN فعلی هنوز برای او کار می‌کند."

