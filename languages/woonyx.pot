#: src/Shared/Http/ErrorMessages.php:108
msgid "This store is not connected to WooNyx yet. Enter your license key to activate it."
msgstr ""

#: src/Shared/Http/ErrorMessages.php:109
msgid "The saved connection to WooNyx can no longer be read, probably because the site’s security keys (salts) changed. Enter your license key again to reconnect."
msgstr ""

#: src/Shared/Http/ErrorMessages.php:110
msgid "The WooNyx server address is invalid. Check WOONYX_API_BASE_URL in wp-config.php: it must be an https address."
msgstr ""

#: src/Shared/Http/ErrorMessages.php:111
msgid "The data could not be prepared for sending to WooNyx."
msgstr ""

#: src/Shared/Http/ErrorMessages.php:112
msgid "Could not reach the WooNyx server. Check this site’s internet connection and try again in a few minutes."
msgstr ""

#: src/Shared/Http/ErrorMessages.php:113
msgid "The WooNyx server answered with a redirect, which is not followed. Check the server address."
msgstr ""

#: src/Shared/Http/ErrorMessages.php:114
msgid "The WooNyx server sent an unexpected answer. Try again later."
msgstr ""

#: src/Shared/Http/ErrorMessages.php:115
msgid "Something went wrong while talking to the WooNyx server. Try again later."
msgstr ""

#: src/Shared/Http/ErrorMessages.php:116
msgid "This is not a WooNyx license key. A license key looks like WN-XXXXXX-XXXXXX-XXXXXX-XXXXXX."
msgstr ""

#: src/Shared/Http/ErrorMessages.php:117
msgid "WooNyx needs this site to use https. Change the WordPress Address and Site Address in Settings → General to https, then try again."
msgstr ""

#: src/Shared/Http/ErrorMessages.php:118
msgid "This site’s REST API is not on the same address as the site, so WooNyx cannot use it. Make the WordPress Address and Site Address in Settings → General use the same scheme, host and port."
msgstr ""

#: src/Shared/Http/ErrorMessages.php:119
msgid "The WooCommerce REST API key WooNyx needs could not be created. Try again; if it keeps failing, check the site’s database error log."
msgstr ""

#: src/Shared/Http/ErrorMessages.php:120
msgid "The store was activated on WooNyx, but the connection could not be saved on this site. Enter your license key again to activate it once more."
msgstr ""

#: src/Shared/Http/ErrorMessages.php:121
msgid "WooNyx issued a new shared secret, but it could not be saved on this site. The current secret still works: rotate it again now."
msgstr ""

#: src/Shared/Http/ErrorMessages.php:124
msgid "The WooNyx server rejected the request as invalid. Update the plugin and try again."
msgstr ""

#: src/Shared/Http/ErrorMessages.php:125
msgid "The WooNyx server did not accept this store’s credentials. Activate the store again with your license key."
msgstr ""

#: src/Shared/Http/ErrorMessages.php:126
msgid "The WooNyx server does not accept this request. Update the plugin."
msgstr ""

#: src/Shared/Http/ErrorMessages.php:127
msgid "Some of the data sent to WooNyx is invalid. Check it and try again."
msgstr ""

#: src/Shared/Http/ErrorMessages.php:128
msgid "The data is too large for the WooNyx server."
msgstr ""

#: src/Shared/Http/ErrorMessages.php:129
msgid "The WooNyx server had an internal error. Try again later."
msgstr ""

#: src/Shared/Http/ErrorMessages.php:130
msgid "The WooNyx server could not read this store’s saved credentials. Activate the store again with your license key."
msgstr ""

#: src/Shared/Http/ErrorMessages.php:131
msgid "Too many attempts. Wait a few minutes and try again."
msgstr ""

#: src/Shared/Http/ErrorMessages.php:134
msgid "The request’s signature was missing or malformed. Activate the store again with your license key."
msgstr ""

#: src/Shared/Http/ErrorMessages.php:135
msgid "The request was rejected because this server’s clock is off by more than five minutes. Correct the server time and try again."
msgstr ""

#: src/Shared/Http/ErrorMessages.php:136
msgid "The request’s signature did not match; the shared secret may be out of date. Activate the store again with your license key."
msgstr ""

#: src/Shared/Http/ErrorMessages.php:137
msgid "The same request reached the WooNyx server twice and was rejected. Try again."
msgstr ""

#: src/Shared/Http/ErrorMessages.php:140
msgid "This license key is not valid. Check it and try again."
msgstr ""

#: src/Shared/Http/ErrorMessages.php:141
msgid "This license key has been revoked. Contact WooNyx support."
msgstr ""

#: src/Shared/Http/ErrorMessages.php:142
msgid "This license key is already used by another website."
msgstr ""

#: src/Shared/Http/ErrorMessages.php:143
msgid "This website is already activated with another license key."
msgstr ""

#: src/Shared/Http/ErrorMessages.php:144
msgid "This store is deactivated or suspended on WooNyx. Activate it again with your license key; if the license was revoked, contact WooNyx support."
msgstr ""

#: src/Shared/Http/ErrorMessages.php:145
msgid "Your WooNyx subscription is not active or has expired. Renew it to continue."
msgstr ""

#: src/Shared/Http/ErrorMessages.php:146
msgid "Your WooNyx plan does not include this messenger. Upgrade your plan to use it."
msgstr ""

#: src/Shared/Http/ErrorMessages.php:147
msgid "The WooNyx server could not sign in to this store’s WooCommerce REST API with the new key. Make sure no security plugin blocks the REST API, then try again."
msgstr ""

#: src/Shared/Http/ErrorMessages.php:148
msgid "The WooNyx server could not reach this store. The site must be public, use https, and its REST API must not redirect."
msgstr ""

#: src/Shared/Http/ErrorMessages.php:149
msgid "This store’s WooCommerce REST API rejected the WooNyx server’s request. Check the firewall and security plugins."
msgstr ""

#: src/Shared/Http/ErrorMessages.php:150
msgid "This store’s WooCommerce REST API sent the WooNyx server an unexpected answer. Check for plugins that change REST API responses."
msgstr ""

#: src/Shared/Http/ErrorMessages.php:153
msgid "A bot is already connected for this messenger. Remove it first to connect another one."
msgstr ""

#: src/Shared/Http/ErrorMessages.php:154
msgid "No bot is connected for this messenger."
msgstr ""

#: src/Shared/Http/ErrorMessages.php:155
msgid "This bot admin no longer exists."
msgstr ""

#: src/Shared/Http/ErrorMessages.php:156
msgid "The messenger rejected this bot token. Check it and try again."
msgstr ""

#: src/Shared/Http/ErrorMessages.php:157
msgid "The messenger’s servers did not respond. Try again in a few minutes."
msgstr ""

