# WordPress and WooCommerce functions come from szepeviktor/phpstan-wordpress (loaded by the extension installer)
# and php-stubs/woocommerce-stubs (its packages file holds Action Scheduler's functions).
parameters:
    level: 8
    phpVersion: 80100
    paths:
        - woonyx.php
        - uninstall.php
        - src
        - tests
    bootstrapFiles:
        - tests/phpstan-bootstrap.php
    scanFiles:
        - vendor/php-stubs/woocommerce-stubs/woocommerce-stubs.php
        - vendor/php-stubs/woocommerce-stubs/woocommerce-packages-stubs.php
